{
  "name": "apply-for-me",
  "version": "1.0.0",
  "description": "This Project will apply to jobs for you based.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:claude": "bash dev-claude.sh",
    "docker:build": "docker build --no-cache -t afm-managed-container:latest ./docker/managed-container",
    "playwright:test": "npx playwright test -c tests/playwright.config.ts",
    "verify:gmail-oauth": "tsx tests/playwright/manual-verify-gmail-oauth.ts",
    "build": "vite build --config client/vite.config.ts && tsc -p server/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:duplication": "npx jscpd .",
    "tsc": "tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "db:push": "npx prisma db push --accept-data-loss && npx prisma db seed",
    "db:seed": "npx prisma db seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource/geist": "^5.2.9",
    "@google-cloud/storage": "^7.19.0",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.8",
    "@prisma/adapter-better-sqlite3": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@types/dockerode": "^4.0.1",
    "better-sqlite3": "^12.6.2",
    "browser-use-sdk": "^3.2.0",
    "chrono-node": "^2.9.0",
    "dockerode": "^5.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "multer": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "jscpd": "^4.0.8",
    "jsdom": "^28.1.0",
    "patchright": "^1.59.4",
    "playwright-extra": "^4.3.6",
    "prisma": "^7.4.2",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
