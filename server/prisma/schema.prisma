// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "generated/client"
}

datasource db {
  provider = "sqlite"
}

// Stored on ApplicationProfile.workAuthorization. US-only options since the
// app currently scopes to US-based positions. Mapped to human-readable
// strings by the prompt builder in jobApplicationService.ts.
enum WorkAuthorization {
  us_citizen
  permanent_resident
  authorized_no_sponsorship_needed
  authorized_future_sponsorship_needed
  sponsorship_required
}

// A reusable bundle of personal info used to fill out job-application forms.
// One row per "identity" the user wants to apply with — e.g. "Default",
// "Tech roles", "Contract work". The Apply flow loads the chosen row by id
// and feeds it into the Browser-Use prompt.
//
// Optional fields are nullable in the DB and only injected into the prompt
// when set, so users can leave them blank without polluting the agent's
// instructions with empty values.
model ApplicationProfile {
  id                  Int                @id @default(autoincrement())
  name                String             @unique // User-facing label, e.g. "Default"
  firstName           String
  middleName          String?
  lastName            String
  email               String
  phone               String
  github              String?
  linkedin            String?
  website             String?
  resumeUrl           String?
  coverLetterUrl      String? // Link to a hosted cover letter (Google Doc / PDF). Agent can open it for cover-letter prompts.
  workAuthorization   WorkAuthorization?
  desiredSalaryMin    Int? // USD, whole dollars; minimum acceptable salary, no max field by design.
  created_date        DateTime           @default(now())
  updated_date        DateTime           @updatedAt

  @@map("application_profiles")
}

// Tracks the application lifecycle of a job listing.
// Other lifecycle statuses (e.g. waiting_for_response, approved, rejected)
// will be handled by separate services and added later.
enum JobStatus {
  init // Just have the job URL, not yet applied
  applying // Application in progress via browser-use
  applied // Application submitted without error
  error_applying // Something went wrong during the application process
  closed // Job listing is no longer accepting applications
  missing_form_url // The resolver could not find an off-platform application form URL; auto-apply is blocked until resolved
}

model JobListing {
  id              Int       @id @default(autoincrement())
  title           String?
  company         String? // Normalized company name. Used together with `title` as the (case-insensitive, whitespace-collapsed) dedup key for the inbox-discovery feature. Nullable on legacy rows until the backfill in jobListingCompanyBackfill.ts populates them.
  url             String
  application_url String? // Off-platform URL where the actual application form lives. Null until the resolver succeeds (or when status=missing_form_url after a failed resolve).
  description     String?
  salary          String?
  location        String?
  live_url        String? // Temporarily holds the browser-use live view URL for the iframe during application
  status          JobStatus @default(init)
  post_date       DateTime?
  created_date    DateTime  @default(now())

  // One row per resolver invocation for this listing — see ApplicationUrlResolutionLog.
  resolution_logs ApplicationUrlResolutionLog[]

  // One row per apply-attempt for this listing — see ApplicationAttemptLogs.
  application_attempt_logs ApplicationAttemptLogs[]

  // Inbox discoveries that resulted in this JobListing being created (i.e. user clicked Import).
  imported_discoveries  DiscoveredJob[] @relation("DiscoveryImports")

  // Inbox discoveries that matched this JobListing's (company, title) at scan time and were
  // therefore marked as duplicates so the UI can render the "Already saved as …" link.
  duplicate_discoveries DiscoveredJob[] @relation("DiscoveryDuplicates")

  @@map("jobs_listing")
}

// Terminal outcomes of one apply-attempt for a JobListing. Mirrors the
// discriminated mapping in deriveAttemptOutcome() in jobApplications.ts so
// queries against application_attempt_logs are type-safe end-to-end.
//   applied         — Browser-Use reported isSuccess=true and the agent reached submission
//   failed          — Generic failure (isSuccess=false, stopped status, or thrown error not covered below)
//   closed_listing  — The listing was detected as no longer accepting applications
//   captcha_blocked — A CAPTCHA was encountered during the run
//   stuck           — The stuck-detector tripped (idle steps on the same URL exceeded threshold)
enum ApplicationAttemptOutcome {
  applied
  failed
  closed_listing
  captcha_blocked
  stuck
}

// One row per apply-attempt for a JobListing. Captures the step-by-step
// run log (JSON-as-text mirroring StepLog[] from jobApplicationService),
// the terminal outcome enum, and the on-disk paths of the canonical
// pre-submit ("review") screenshot and the per-attempt log directory
// (which holds every step's screenshot for debugging).
//
// Stored as a normal table (not an embedded JSON column on JobListing) so
// retries accumulate rather than overwrite, and the per-job
// /jobs/:id/attempts page can render an attempt history.
//
// `logs` is stored as JSON-in-text (SQLite has no first-class JSON column,
// matching the ApplicationUrlResolutionLog convention below). The route
// layer parses it before sending to the client.
//
// `submission_screenshot_path` is null when the agent never reached Phase 4
// (e.g. closed_listing detected early, captcha blocked, stuck in earlier
// phases, or the Phase-4 step had no screenshotUrl).
//
// `log_directory` points at the per-run logs folder so the per-step
// screenshot streaming endpoint can locate `step-{n}.png` files.
model ApplicationAttemptLogs {
  id                         Int                       @id @default(autoincrement())
  job_listing_id             Int // FK to JobListing.id; ON DELETE CASCADE so attempt history vanishes with its listing
  job_listing                JobListing                @relation(fields: [job_listing_id], references: [id], onDelete: Cascade)
  logs                       String // JSON-as-text of StepLog[]; parsed by the route layer
  end_response               ApplicationAttemptOutcome // Terminal outcome — see ApplicationAttemptOutcome above
  submission_screenshot_path String? // Absolute on-disk path to the first Phase-4 step screenshot; null when Phase 4 wasn't reached or had no screenshotUrl
  log_directory              String? // Absolute on-disk path to the per-run logs folder (logs/{jobId}-{timestamp}); null on rows from before this column existed
  created_date               DateTime                  @default(now())

  @@index([job_listing_id, created_date])
  @@map("application_attempt_logs")
}


// Possible verdicts the application-URL resolver can land on. Mirrors the
// discriminated union ResolverOutcome in applicationUrlResolverService.ts so
// queries against application_url_resolution_logs are type-safe end-to-end.
enum ApplicationUrlResolutionOutcome {
  direct
  resolved_via_redirect
  resolved_via_search
  resolved_via_careers_page
  not_found
}

// One row per resolver invocation — captured even on the success outcomes so
// the user can audit which candidate the resolver picked. Stored as a normal
// table (not an embedded JSON column on JobListing) so retries accumulate
// rather than overwrite, and the UI can render an attempt history.
//
// The row is INSERTed at the start of a resolver attempt with outcome=null so
// the live-trace UI can find it (and the managed_container_id it points at)
// while the resolver is still running. The route layer UPDATEs the row with
// the terminal outcome + final fields when the resolver settles.
//
// Both `brave_results` and `inspected_candidates` are stored as JSON-in-text
// (SQLite has no first-class JSON column, and this matches the existing
// ApplicationAttemptLogs convention above). The route layer parses them
// before sending to the client so callers don't have to double-parse.
model ApplicationUrlResolutionLog {
  id                    Int                               @id @default(autoincrement())
  job_listing_id        Int
  job_listing           JobListing                        @relation(fields: [job_listing_id], references: [id], onDelete: Cascade)
  managed_container_id  Int? // The container that hosted this attempt's live progress map; null on rows from before this feature.
  managed_container     ManagedContainer?                 @relation(fields: [managed_container_id], references: [id], onDelete: SetNull)
  outcome               ApplicationUrlResolutionOutcome? // null while the attempt is still running; populated to a terminal outcome on finalize.
  search_query          String? // null when the resolver short-circuited before web search
  brave_results         String                            @default("[]") // JSON: { title, url, description }[]
  inspected_candidates  String                            @default("[]") // JSON: { url, scrapedTitle, matched, rejectionReason }[]
  final_application_url String? // The URL adopted on this attempt; null on not_found
  reason                String? // Free-text reason; mainly populated for not_found
  created_date          DateTime                          @default(now())

  @@index([job_listing_id, created_date])
  @@map("application_url_resolution_logs")
}

// Tracks lifecycle of a managed Docker container spawned via the API.
enum ManagedContainerStatus {
  starting
  running
  stopped
  error
}

// Lifecycle of an inbox-discovered job candidate. A DiscoveredJob row is created
// by the inbox scanner when Claude extracts a posting from an email; it stays
// `pending` until the user takes action on it.
//   pending    — Default. Eligible for import or dismiss.
//   imported   — User clicked Import. `imported_job_listing_id` points at the new JobListing row.
//   duplicate  — Scan found a JobListing already exists with matching (company, title). `duplicate_of_job_id` points at the pre-existing row; the user cannot import this row (already saved). Distinct from `imported` because the user did not act on THIS row directly.
//   dismissed  — User clicked Dismiss. Hidden from the default filter on the inbox page.
enum DiscoveredJobStatus {
  pending
  imported
  duplicate
  dismissed
}

// One row per (email × extracted-job) returned by the inbox scanner. One Gmail
// message can yield 0..N rows depending on what Claude finds in the body — a
// "5 jobs matching your search" digest email produces 5 rows, a single-pitch
// recruiter email produces 1, an unrelated newsletter that matched the
// keyword search produces 0.
//
// The `@@unique([gmail_connection_id, email_message_id, company, title, location])`
// makes re-scanning idempotent regardless of URL drift: LinkedIn job-alert
// URLs embed a rotating `trackingId` query parameter, so if `job_url` were
// part of the key, the same email re-scanned tomorrow would create a brand-
// new row. The (company, title, location) triple is the identity of the
// posting; a digest email listing five jobs produces five rows because each
// triple differs, while a re-scan of any one of those emails refreshes the
// existing row in place. Including `location` distinguishes the same role
// posted in multiple cities (e.g. "Engineer @ Acme — Remote" vs "Engineer
// @ Acme — NYC"). Uniqueness is case-insensitive via a `COLLATE NOCASE`
// index applied as raw SQL after `prisma db push` (Prisma's SQLite driver
// doesn't expose collation on @@unique). The index also wraps `location` in
// `COALESCE(location, '')` so NULL-location rows collapse rather than
// inserting duplicates (SQLite treats NULL as distinct in unique indexes
// unless instructed otherwise).
//
// `duplicate_of_job_id` is set at scan time when a JobListing with case-
// insensitive matching (company, title, location) already exists; in that
// case the row is also born with `status="duplicate"` so the UI can render
// it as already-saved and the import endpoint refuses to act on it. At
// import time, sibling discoveries with matching (company, title, location)
// get flipped to `status="duplicate"` + this FK in the same transaction
// that creates the new JobListing.
//
// `imported_job_listing_id` is set when the user clicks Import, atomically
// within the same transaction that creates the JobListing row.
model DiscoveredJob {
  id                      Int                  @id @default(autoincrement())
  gmail_connection_id     Int
  gmail_connection        GmailConnection      @relation(fields: [gmail_connection_id], references: [id], onDelete: Cascade)

  // Source email metadata — enough to render the design's `.email-tag` and
  // `.disc-group-head` plus deep-link back to Gmail.
  email_message_id        String
  email_thread_id         String?
  email_from_name         String
  email_from_address      String
  email_subject           String
  email_snippet           String?
  email_received_at       DateTime
  email_label_color       String? // Hex string derived from sender domain via senderColorPalette.ts; nullable for unknown senders.

  // Extracted job fields. `company` and `title` are the dedup identity
  // (normalized at compare time, stored as Claude returned them).
  title                   String
  company                 String
  job_url                 String
  location                String?
  salary                  String?
  description             String?

  // Lifecycle
  status                  DiscoveredJobStatus  @default(pending)
  imported_job_listing_id Int?
  imported_job_listing    JobListing?          @relation("DiscoveryImports", fields: [imported_job_listing_id], references: [id], onDelete: SetNull)
  duplicate_of_job_id     Int?
  duplicate_of_job        JobListing?          @relation("DiscoveryDuplicates", fields: [duplicate_of_job_id], references: [id], onDelete: SetNull)

  confidence              Float // 0..1 self-reported by the extractor.
  created_date            DateTime             @default(now())
  updated_date            DateTime             @updatedAt

  @@unique([gmail_connection_id, email_message_id, company, title, location], map: "discovered_jobs_dedupe_key")
  @@index([gmail_connection_id, status, email_received_at])
  @@map("discovered_jobs")
}

// One row per Google account that has granted this app `gmail.readonly` (and
// the openid/email identity scopes used to derive `google_email`). Tokens are
// stored in plaintext for now — same security posture as DATABASE_URL on disk
// — and replaced atomically by the refresh-on-expiry path in
// gmailConnectionService.getValidAccessToken().
//
// `google_email` is UNIQUE so re-running the OAuth dance for an already-
// connected inbox upserts onto the same row instead of duplicating it.
//
// `access_token_expires_at` is the absolute expiry returned by Google
// (`Date.now() + expires_in * 1000`); callers consult it with a small
// negative skew (~60s) before deciding whether to refresh.
//
// `scopes` is the space-separated grant string returned by Google; storing it
// lets us detect when a future feature requires a scope the user hasn't
// granted yet and prompt for re-consent.
model GmailConnection {
  id                      Int      @id @default(autoincrement())
  google_email            String   @unique
  refresh_token           String
  access_token            String
  access_token_expires_at DateTime
  scopes                  String
  created_date            DateTime @default(now())
  updated_date            DateTime @updatedAt

  // Inbox-discovered job candidates extracted from this Gmail account's messages.
  discovered_jobs         DiscoveredJob[]

  @@map("gmail_connections")
}

// Records each Docker container spawned through the managed-containers API.
// dockerId is Docker's full container ID; name is the user-visible name (without the afm- prefix).
model ManagedContainer {
  id            Int                    @id @default(autoincrement())
  name          String                 @unique
  dockerId      String                 @unique
  hostPort      Int                    @unique
  wgConfigName  String? // Filename (without .conf) of the WireGuard config used by this container; null on records created before WG support
  status        ManagedContainerStatus @default(starting)
  created_date  DateTime               @default(now())

  // Resolution attempts that have used this container's in-memory progress map.
  resolution_logs ApplicationUrlResolutionLog[]

  @@map("managed_containers")
}
