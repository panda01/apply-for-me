{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "server.ts",
    "agent.ts",
    "popup.ts",
    "smartproxy.ts",
    "resolutionProgressStore.ts",
    "resolutionTypes.ts",
    "*.test.ts"
  ]
}
